  "bug_fixes_applied": [
    { "id": "fe-fix-1", "area": "AuthProvider", "fix": "Wrap new URL(url) in try/catch — malformed deep-link URLs no longer crash the app on startup" },
    { "id": "fe-fix-2", "area": "AuthProvider", "fix": "signOut rewritten as proper async function (was .then() fire-and-forget)" },
    { "id": "fe-fix-3", "area": "AuthScreen", "fix": "completeOAuthRedirect wraps new URL() in try/catch — returns error string instead of throwing" },
    { "id": "fe-fix-4", "area": "DeadlinesScreen", "fix": "Extract compareDeadlines to module level so edit-modal sort matches load and markDone order" },
    { "id": "fe-fix-5", "area": "DeadlinesScreen", "fix": "Add aliveRef + cleanup useEffect to prevent setState after unmount on slow network" },
    { "id": "fe-fix-6", "area": "ChatThreadScreen", "fix": "Replace pendingDoneHandled state with useRef — eliminates stale closure bug in SSE event listener" },
    { "id": "fe-fix-7", "area": "ChatThreadScreen", "fix": "Add alive flags in both useEffects to prevent setState after unmount" },
    { "id": "fe-fix-8", "area": "ChatThreadScreen", "fix": "Make onOpenViewer optional on DocumentAttachmentBubble — crash with multiple images fixed" },
    { "id": "fe-fix-9", "area": "ProfileScreen", "fix": "Move SHEET_HIDDEN constant to module level (was re-created on every render)" },
    { "id": "fe-fix-10", "area": "ProfileScreen", "fix": "Add aliveRef + cleanup to prevent setState after unmount in loadLimits" },
    { "id": "fe-fix-11", "area": "ScanListScreen", "fix": "Add aliveRef + bail-out in load callback to prevent setState after unmount" }
  ],

