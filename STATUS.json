{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "project": "Jasne frontend",
    "snapshot_date": "2026-05-12",
    "repo_path": "/Users/alisheribrayev/Documents/Jasne/jasne-frontend",
    "app_name": "Jasne",
    "current_version": "0.1.0",
    "phase": "Expo MVP core loop in active development",
    "backend_live_url": "https://jasne-backend-production.up.railway.app",
    "backend_repo_path": "/Users/alisheribrayev/Documents/Jasne/jasne-backend"
  },

  "infrastructure": {
    "mobile_runtime": {
      "framework": "Expo",
      "expo_sdk": "52",
      "react_native": "0.76.9",
      "react": "18.3.1",
      "router": "expo-router 4",
      "typescript": "5.3.3",
      "typescript_strict_expected": true,
      "native_build_required": true,
      "expo_go_status": "partial only",
      "expo_go_notes": [
        "Core JS screens can run in Expo Go.",
        "Native document scanner, custom URL schemes, OAuth redirects, and password reset links should be tested in a development build."
      ]
    },
    "app_identity": {
      "scheme": "jasne",
      "ios_bundle_identifier": "app.jasne.mobile",
      "android_package": "app.jasne.mobile",
      "orientation": "portrait",
      "supports_tablet": false,
      "user_interface_style": "automatic"
    },
    "supabase": {
      "project_id": "ndestbxknbgaxxdjoqkv",
      "services_used": [
        "Auth",
        "Storage",
        "Postgres through backend API"
      ],
      "storage_bucket": "documents",
      "storage_bucket_public": false,
      "storage_path_contract": "<user_id>/<filename>",
      "storage_rls_expected": "auth.uid()::text = (storage.foldername(name))[1]"
    },
    "backend_api": {
      "base_url": "https://jasne-backend-production.up.railway.app",
      "auth_header": "Authorization: Bearer <supabase_access_token>",
      "health": "GET /health",
      "deep_health": "GET /health/deep"
    },
    "local_environment": {
      "required_public_env": [
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY",
        "EXPO_PUBLIC_API_BASE_URL"
      ],
      "optional_public_env": [
        "EXPO_PUBLIC_APP_LOCALE"
      ],
      "current_api_base_url_default": "https://jasne-backend-production.up.railway.app",
      "secrets_policy": "STATUS.json intentionally does not store anon key or other secrets."
    },
    "ios_native": {
      "xcode_required": true,
      "cocoapods_required": true,
      "physical_device_requires_signing": true,
      "known_device": "iPhone Alisher (iOS 18.7.2)",
      "apple_developer_program_required_for": [
        "Sign in with Apple capability",
        "App Store/TestFlight distribution",
        "stable production signing"
      ]
    }
  },

  "frontend": {
    "stack": {
      "navigation": "Expo Router file-based routing",
      "state": "React hooks + small local stores",
      "auth_client": "@supabase/supabase-js",
      "storage_client": "@supabase/supabase-js Storage",
      "http": "fetch wrapper in src/lib/api.ts",
      "sse": "custom fetch stream parser in src/lib/sse.ts",
      "file_access": [
        "expo-image-picker",
        "expo-document-picker",
        "expo-file-system"
      ],
      "native_scanner": "react-native-document-scanner-plugin",
      "styling": "React Native StyleSheet + shared color tokens in src/components/ui.tsx",
      "i18n": "local dictionary in src/lib/i18n.ts"
    },
    "routes": {
      "root": [
        {
          "file": "app/_layout.tsx",
          "purpose": "Safe area, locale provider, auth provider, root auth/app switch"
        }
      ],
      "tabs": [
        {
          "file": "app/(app)/_layout.tsx",
          "route": "(app)",
          "purpose": "Bottom tab shell: documents, deadlines, profile"
        },
        {
          "file": "app/(app)/index.tsx",
          "route": "/",
          "screen": "Documents / scan threads"
        },
        {
          "file": "app/(app)/deadlines.tsx",
          "route": "/deadlines",
          "screen": "Deadlines"
        },
        {
          "file": "app/(app)/profile.tsx",
          "route": "/profile",
          "screen": "Profile"
        }
      ],
      "scan": [
        {
          "file": "app/(app)/scan/new.tsx",
          "route": "/scan/new",
          "screen": "New scan"
        },
        {
          "file": "app/(app)/scan/[id].tsx",
          "route": "/scan/:id",
          "screen": "Chat thread with result card"
        }
      ]
    },
    "modules": {
      "components": {
        "file": "src/components/ui.tsx",
        "contains": [
          "shared colors",
          "Screen",
          "AppBar",
          "Button",
          "IconButton",
          "Field",
          "EmptyState",
          "ErrorText"
        ]
      },
      "auth": {
        "files": [
          "src/features/auth/AuthProvider.tsx",
          "src/features/auth/AuthScreen.tsx",
          "src/features/auth/ResetPasswordScreen.tsx",
          "src/features/auth/ProfileScreen.tsx"
        ],
        "features": {
          "email_password_signup": true,
          "email_password_login": true,
          "google_oauth": true,
          "password_reset_email": true,
          "password_reset_deep_link_screen": true,
          "apple_sign_in": false,
          "session_persistence": true,
          "auth_error_mapping": true
        },
        "redirects": {
          "google_callback": "jasne://auth/callback",
          "password_reset": "generated by expo-linking, printed as Password reset redirect URL in Metro logs"
        }
      },
      "scans": {
        "files": [
          "src/features/scans/ScanListScreen.tsx",
          "src/features/scans/NewScanScreen.tsx",
          "src/features/scans/scansApi.ts",
          "src/features/scans/pendingScanStore.ts"
        ],
        "features": {
          "scan_thread_list": true,
          "new_scan_flow": true,
          "multi_image_selection": true,
          "document_pdf_selection": true,
          "native_camera_scanner_hook": true,
          "supabase_storage_upload": true,
          "scan_stream_sse": true,
          "pending_chat_progress": true,
          "navigate_to_created_thread_on_done": true,
          "storage_upload_error_mapping": true,
          "limits_gate_before_scan": true
        },
        "storage_upload_contract": {
          "bucket": "documents",
          "path_format": "<supabase_user_id>/<timestamp>-<page_index>-<safe_filename>.<ext>",
          "supported_input_mime_types": [
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp",
            "application/pdf"
          ],
          "backend_body": "{ image_paths: string[], language: cs|ru|uk|en }"
        }
      },
      "chat": {
        "files": [
          "src/features/chat/ChatThreadScreen.tsx",
          "src/features/chat/chatApi.ts"
        ],
        "features": {
          "load_scan_detail": true,
          "load_thread_messages": true,
          "result_card": true,
          "uploaded_document_image_preview": true,
          "signed_storage_urls_for_images": true,
          "chat_stream_sse": true,
          "assistant_token_append": true,
          "input_disabled_while_streaming": true,
          "free_plan_chat_warning": true
        }
      },
      "deadlines": {
        "files": [
          "src/features/deadlines/DeadlinesScreen.tsx",
          "src/features/deadlines/deadlinesApi.ts"
        ],
        "features": {
          "list_deadlines": true,
          "group_active_by_month": true,
          "single_completed_section": true,
          "manual_deadline_create": true,
          "deadline_edit": true,
          "deadline_complete": true,
          "deadline_delete": true,
          "swipe_left_edit_delete": true,
          "swipe_right_complete": true,
          "completed_swipe_disabled": true
        },
        "ux_state": "Dark Jasne design system applied, swipe cards still being iterated visually."
      },
      "localization": {
        "files": [
          "src/lib/i18n.ts",
          "src/lib/LocaleContext.tsx"
        ],
        "locales": [
          "cs",
          "ru",
          "uk",
          "en"
        ],
        "default_locale": "cs unless EXPO_PUBLIC_APP_LOCALE is set",
        "runtime_locale_switch": true
      },
      "shared_lib": {
        "files": [
          "src/lib/api.ts",
          "src/lib/config.ts",
          "src/lib/sse.ts",
          "src/lib/supabase.ts",
          "src/lib/types.ts"
        ],
        "responsibilities": [
          "runtime env config",
          "Supabase client",
          "authorized API fetch",
          "SSE parsing",
          "shared API response types"
        ]
      }
    },
    "api_usage": {
      "profile": [
        "GET /profile",
        "PUT /profile"
      ],
      "limits": [
        "GET /limits",
        "GET /limits?scan_id=<uuid>"
      ],
      "scans": [
        "GET /scans?limit=50&offset=0",
        "GET /scans/{scan_id}",
        "POST /scans/stream"
      ],
      "chat": [
        "GET /scans/{scan_id}/chat",
        "POST /scans/{scan_id}/chat/stream"
      ],
      "deadlines": [
        "GET /deadlines?only_active=false",
        "POST /deadlines",
        "PATCH /deadlines/{deadline_id}",
        "DELETE /deadlines/{deadline_id}"
      ]
    }
  },

