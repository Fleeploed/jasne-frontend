{
  "expo": {
    "name": "Jasne",
    "slug": "jasne",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jasne",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.jasne.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Jasne uses the camera to scan bureaucracy documents.",
        "NSPhotoLibraryUsageDescription": "Jasne can upload documents selected from your library."
      }
    },
    "android": {
      "package": "app.jasne.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16458A"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-image-picker",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Jasne uses the camera to scan bureaucracy documents."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
