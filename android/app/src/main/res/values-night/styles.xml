<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">#0F0D0B</item>
    <item name="android:colorAccent">#6FA0E6</item>
    <item name="android:textColor">#F4EFE6</item>
    <item name="android:editTextStyle">@style/ResetEditText</item>
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">#0F0D0B</item>
    <item name="android:navigationBarColor">#0F0D0B</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>

  <style name="ResetEditText" parent="@android:style/Widget.EditText">
    <item name="android:padding">0dp</item>
    <item name="android:textColorHint">#6F675D</item>
    <item name="android:textColor">#F4EFE6</item>
  </style>
</resources>
