{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jasne-backend-api-production.up.railway.app",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "pro"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jasne-backend-api-production.up.railway.app",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "pro"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jasne-backend-api-production.up.railway.app",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "pro"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
